# 복사해서 .env로 만들어 씁니다. .env는 저장소에 넣지 않습니다.

# azure 또는 ollama
LLM_PROVIDER=ollama

# /ask 호출용 키. 32자 이상 임의 값을 넣으세요.
API_KEY=

# 근거 판단 임계치(@search.score). 모델별로 보정한 값을 넣으세요(src/calibrate.py).
# 로컬 bge-m3 + llama3.2는 0.6411, Azure 모델은 척도가 달라 따로 보정합니다.
MIN_SEARCH_SCORE=0.6411

# LLM_PROVIDER=azure일 때 필요합니다. azd provision 출력값을 씁니다. 키는 쓰지 않습니다(az login 또는 관리 ID).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=docs

# LLM_PROVIDER=ollama일 때 선택 사항입니다.
# OLLAMA_CHAT_MODEL=llama3.2
# OLLAMA_EMBEDDING_MODEL=bge-m3
